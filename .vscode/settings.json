{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true,
        "**/.ruff_cache": true,
        "**/.pytest_cache": true,
    },
    "editor.acceptSuggestionOnEnter": true,
    "editor.quickSuggestions": {
        "other": false,
        "comments": false,
        "strings": false
    },
    "editor.quickSuggestionsDelay": 300
}
